// SPDX-License-Identifier: Apache-2.0
cc_library_shared {
    name: "libwifi-hal-mt6580",
    vendor: true,
    compile_multilib: "32",
    srcs: ["wifi_hal.cpp"],
    header_libs: ["wifi_legacy_headers"],
    shared_libs: ["liblog"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}

cc_library_static {
    name: "lib_driver_cmd_mt6580",
    vendor: true,
    srcs: ["driver_cmd.c"],
    header_libs: ["wpa_supplicant_headers"],
    shared_libs: ["libnl"],
    cflags: ["-Wall", "-Wextra", "-Werror", "-Wno-unused-parameter"],
}
