DEVICE_PATH := device/aic/a1260

TARGET_ARCH := arm
TARGET_ARCH_VARIANT := armv7-a-neon
TARGET_CPU_VARIANT := cortex-a7
TARGET_CPU_ABI := armeabi-v7a
TARGET_CPU_ABI2 := armeabi
TARGET_BOARD_PLATFORM := mt6580
TARGET_BOOTLOADER_BOARD_NAME := WT6580_WE_N
TARGET_NO_BOOTLOADER := true
TARGET_NO_RECOVERY := true

# The LK bootloader accepts header v0 and a zImage with an appended DTB.
BOARD_BOOT_HEADER_VERSION := 0
BOARD_KERNEL_BASE := 0x80000000
BOARD_KERNEL_PAGESIZE := 2048
BOARD_KERNEL_IMAGE_NAME := zImage
BOARD_KERNEL_APPEND_DTBS := mediatek/mt6580-wt6580-we-n-drm.dtb
BOARD_MKBOOTIMG_ARGS += --header_version 0 --kernel_offset 0x00008000
BOARD_MKBOOTIMG_ARGS += --ramdisk_offset 0x04000000 --tags_offset 0x0e000000
BOARD_KERNEL_CMDLINE := earlycon console=ttyS0,921600n8 console=ttyGS0
BOARD_KERNEL_CMDLINE += androidboot.hardware=mt6580 androidboot.boot_devices=11120000.mmc
BOARD_KERNEL_CMDLINE += maxcpus=1 clk_ignore_unused pd_ignore_unused panic=15
BOARD_KERNEL_CMDLINE += androidboot.selinux=permissive enforcing=0
BOARD_KERNEL_CMDLINE += printk.devkmsg=on
BOARD_RAMDISK_USE_LZ4 := false

TARGET_KERNEL_SOURCE := kernel/aic/mt6580
TARGET_KERNEL_ARCH := arm
TARGET_KERNEL_CONFIG := wt6580_we_n_defconfig wt6580_android17.config
TARGET_KERNEL_CONFIG_EXT := $(DEVICE_PATH)/kernel/a1260.config
TARGET_KERNEL_CLANG_PATH := $(abspath prebuilts/clang/host/linux-x86/clang-r547379)
TARGET_KERNEL_LIBC_SYSROOT_USE := host
TARGET_KERNEL_ADDITIONAL_FLAGS := -j6

# Actual GPT sizes. There is no super, product or system_ext partition.
BOARD_BOOTIMAGE_PARTITION_SIZE := 16777216
BOARD_RECOVERYIMAGE_PARTITION_SIZE := 16777216
BOARD_SYSTEMIMAGE_PARTITION_SIZE := 1610612736
BOARD_VENDORIMAGE_PARTITION_SIZE := 427819008
BOARD_CACHEIMAGE_PARTITION_SIZE := 268435456
BOARD_USERDATAIMAGE_PARTITION_SIZE := 5317853184
BOARD_FLASH_BLOCK_SIZE := 131072
TARGET_USERIMAGES_USE_EXT4 := true
BOARD_SYSTEMIMAGE_FILE_SYSTEM_TYPE := erofs
BOARD_EROFS_COMPRESSOR := lz4hc,9
BOARD_VENDORIMAGE_FILE_SYSTEM_TYPE := ext4
BOARD_CACHEIMAGE_FILE_SYSTEM_TYPE := ext4
BOARD_USERDATAIMAGE_FILE_SYSTEM_TYPE := ext4
TARGET_COPY_OUT_VENDOR := vendor
TARGET_COPY_OUT_PRODUCT := system/product
TARGET_COPY_OUT_SYSTEM_EXT := system/system_ext
BOARD_AVB_ENABLE := false
BOARD_USES_METADATA_PARTITION := true

BOARD_SEPOLICY_DIRS += $(DEVICE_PATH)/sepolicy/vendor
BOARD_SEPOLICY_DIRS += external/minigbm/cros_gralloc/sepolicy
DEVICE_MANIFEST_FILE := $(DEVICE_PATH)/manifest.xml
TARGET_RECOVERY_FSTAB := $(DEVICE_PATH)/rootdir/fstab.mt6580
TARGET_SCREEN_WIDTH := 480
TARGET_SCREEN_HEIGHT := 800
