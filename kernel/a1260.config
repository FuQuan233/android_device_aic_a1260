# Dedicated Android boot image: PID 1 comes from the external ramdisk.
CONFIG_INITRAMFS_SOURCE=""
CONFIG_ARM_ATAG_DTB_COMPAT=y
CONFIG_ARM_APPENDED_DTB_INITRD_FROM_BOOTLOADER=y
CONFIG_ARM_ATAG_DTB_COMPAT_CMDLINE_EXTEND=y
CONFIG_CMDLINE="earlycon console=ttyS0,921600n8 panic=15 mem_sleep_default=deep androidboot.hardware=mt6580 androidboot.boot_devices=11120000.mmc androidboot.selinux=permissive enforcing=0 printk.devkmsg=on androidboot.audio.tinyalsa.simulate_input=true androidboot.audio.tinyalsa.ignore_output=true"
# CONFIG_FB_MT6580_LK is not set
CONFIG_DRM_MEDIATEK=y
# CONFIG_DRM_LIMA is not set
CONFIG_MALI400=y
CONFIG_PINCTRL_MT6580=y
CONFIG_I2C_MT65XX=y
CONFIG_I2C_CHARDEV=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_EDT_FT5X06=y
CONFIG_MTK_MT6580_PMIC_WRAP=y
CONFIG_REGULATOR_MT6350=y
CONFIG_MFD_MT6397=y
CONFIG_KEYBOARD_MTK_PMIC=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_PINCTRL_AW9523=y
CONFIG_GPIO_AW9106=y
CONFIG_POWER_SUPPLY=y
CONFIG_BATTERY_MT6350=y
CONFIG_CHARGER_BQ24190=y
CONFIG_PWM=y
CONFIG_PWM_MTK_DISP=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_PM_WAKELOCKS=y
CONFIG_PHY_MTK_MIPI_DSI=y
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_DMADEVICES=y
# CONFIG_DRM_FBDEV_EMULATION is not set
# Configfs owns the UDC and exposes only FunctionFS/ADB.
# CONFIG_USB_G_SERIAL is not set
CONFIG_USB_CONFIGFS=y
# CONFIG_USB_CONFIGFS_ACM is not set
CONFIG_USB_CONFIGFS_F_FS=y
# CONFIG_U_SERIAL_CONSOLE is not set

# Calibrated SoC temperature and cluster-wide CPU cooling.
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_THERMAL_HWMON=y
CONFIG_THERMAL_DEFAULT_GOV_STEP_WISE=y
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_CPU_THERMAL=y
CONFIG_MTK_THERMAL=y
CONFIG_MTK_SOC_THERMAL=y
CONFIG_NVMEM_MTK_EFUSE=y

# MT6580 GPU DFS retains the CPU-owned shared voltage rail.
CONFIG_PM_DEVFREQ=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y
CONFIG_DEVFREQ_GOV_PERFORMANCE=y
CONFIG_DEVFREQ_GOV_POWERSAVE=y
CONFIG_DEVFREQ_GOV_USERSPACE=y
CONFIG_MALI400_DEVFREQ=y

# PCM execution/timer wake and PWRAP handoff; retained-state standby only.
CONFIG_MTK_MT6580_SPM=y

# This remote never loads modem firmware; quiesce TOPSM/ABB then MD1.
CONFIG_MTK_MT6580_MODEM_OFF=y

# PMIC physical USB cable detection and wakeup
CONFIG_EXTCON=y
CONFIG_EXTCON_MT6350=y
