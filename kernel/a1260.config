# Dedicated Android boot image: PID 1 comes from the external ramdisk.
CONFIG_INITRAMFS_SOURCE=""
CONFIG_ARM_ATAG_DTB_COMPAT=y
CONFIG_ARM_APPENDED_DTB_INITRD_FROM_BOOTLOADER=y
CONFIG_ARM_ATAG_DTB_COMPAT_CMDLINE_EXTEND=y
CONFIG_CMDLINE="earlycon console=ttyS0,921600n8 console=ttyGS0 maxcpus=1 clk_ignore_unused pd_ignore_unused panic=15 androidboot.hardware=mt6580 androidboot.boot_devices=11120000.mmc androidboot.selinux=permissive enforcing=0 printk.devkmsg=on"
# CONFIG_FB_MT6580_LK is not set
CONFIG_DRM_MEDIATEK=y
CONFIG_PHY_MTK_MIPI_DSI=y
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_DMADEVICES=y
# CONFIG_DRM_FBDEV_EMULATION is not set
# Configfs owns the UDC; ACM and FunctionFS/ADB share the same configuration.
# CONFIG_USB_G_SERIAL is not set
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_U_SERIAL_CONSOLE=y
