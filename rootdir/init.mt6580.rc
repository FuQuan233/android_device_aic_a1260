import /vendor/etc/init/hw/init.mt6580.usb.rc

on init
    start vendor.a1260-watchdog
    # Apply Android's normal overcommit policy before ART reserves its heap.
    write /proc/sys/vm/overcommit_memory 1

on fs
    mount_all /vendor/etc/fstab.mt6580 --early
    # ART runs inside the platform post-fs-data action, before the vendor one.
    # Make swap available before dex2oat reserves its initial heap.
    swapon_all /vendor/etc/fstab.mt6580

on post-fs-data
    start vendor.a1260-logcat
    exec_start vendor.a1260-usb-setup

service vendor.a1260-watchdog /system/bin/watchdogd 5 25
    class core
    user root
    group root
    seclabel u:r:watchdogd:s0

service vendor.a1260-usb-setup /vendor/bin/a1260-usb-setup
    disabled
    oneshot
    user root
    group root shell
    seclabel u:r:vendor_init:s0
    stdio_to_kmsg

# Keep fatal userspace diagnostics visible on the physical UART while USB
# debug is being brought up. Exclude the kernel buffer to avoid feedback.
service vendor.a1260-logcat /system/bin/logcat -b main -b system -b crash -v brief *:E Netd:V adbd:V IptablesRestoreController:V
    class core
    disabled
    user root
    group root shell log readproc
    seclabel u:r:shell:s0
    stdio_to_kmsg
