# Dedicated fixed-GPT layout. No automatic formatting during bring-up.
# block device          mount point  type   mount flags                         fs_mgr flags
/dev/block/mmcblk0p19    /system      erofs  ro                                  wait,first_stage_mount
/dev/block/mmcblk0p12    /vendor      ext4   ro,noatime                          wait,first_stage_mount
/dev/block/mmcblk0p20    /cache       ext4   noatime,nosuid,nodev                 wait,check
/dev/block/mmcblk0p21    /data        ext4   noatime,nosuid,nodev,discard         wait,check,quota
# Compressed RAM swap only; no eMMC backing file or partition.
/dev/block/zram0        none         swap   defaults                            wait,zramsize=536870912,swapprio=32758
