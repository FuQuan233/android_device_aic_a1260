# Dedicated fixed-GPT layout. No automatic formatting during bring-up.
# block device          mount point  type   mount flags                         fs_mgr flags
/dev/block/by-name/system      /system  erofs  ro                           wait,first_stage_mount
/dev/block/by-name/vendor      /vendor  ext4   ro,noatime                   wait,first_stage_mount
/dev/block/by-name/cache       /cache   ext4   noatime,nosuid,nodev          wait,check
/dev/block/by-name/userdata    /data    ext4   noatime,nosuid,nodev,discard  wait,check,quota
# Compressed RAM swap only; no eMMC backing file or partition.
/dev/block/zram0        none         swap   defaults                            wait,zramsize=536870912,swapprio=32758
