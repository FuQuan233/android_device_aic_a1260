# Standard init.usb.configfs.rc owns the FunctionFS link and UDC binding.
# Keep progress markers visible on the physical UART during ADB bring-up.
on property:sys.usb.ffs.ready=1 && property:sys.usb.config=adb && property:sys.usb.configfs=1
    write /dev/kmsg "A1260 USB: adbd FunctionFS descriptors ready"

on property:sys.usb.state=adb && property:sys.usb.configfs=1
    write /dev/kmsg "A1260 USB: common ADB configfs action completed"
