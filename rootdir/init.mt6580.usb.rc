# This action is imported before init.usb.configfs.rc. Prepare ACM before
# the common FFS-ready action binds the controller, retaining standard "adb".
on property:sys.usb.config=adb && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/bDeviceClass 239
    write /config/usb_gadget/g1/bDeviceSubClass 2
    write /config/usb_gadget/g1/bDeviceProtocol 1
    symlink /config/usb_gadget/g1/functions/acm.gs0 /config/usb_gadget/g1/configs/b.1/f2
