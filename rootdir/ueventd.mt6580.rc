# The Utgard GPU has /dev/mali; the in-process mapper imports CMA buffers on
# the KMS primary node because there is no separate DRM GPU render node.
/dev/dri/card*             0666 system graphics
/dev/dri/renderD*          0666 system graphics
/dev/mali                  0666 system graphics
# DMA heaps inherit AOSP 0444 system:system for app MediaCodec allocation.
/dev/watchdog              0600 root root
/dev/watchdog0             0600 root root
/dev/block/mmcblk0p*       0600 root root

# drm_hwcomposer uses the standard backlight sysfs controller.
/sys/devices/platform/backlight/backlight/backlight brightness 0664 system graphics
/sys/devices/platform/backlight/backlight/backlight bl_power 0664 system graphics

# Only the separately privileged worker can use this CAP_SYS_RAWIO UAPI.
/dev/mt6580-vcodec          0660 mediacodec mediacodec
