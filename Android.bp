soong_namespace {}
package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}
sh_binary {
    name: "a1260-usb-setup",
    src: "rootdir/a1260-usb-setup.sh",
    vendor: true,
}

cc_binary {
    name: "a1260-gpu-info",
    vendor: true,
    srcs: ["tools/gpu_info.c"],
    header_libs: ["gl_headers"],
    shared_libs: ["libEGL", "libGLESv2"],
    cflags: ["-Wall", "-Werror"],
}

filegroup {
    name: "a1260-utgard-hwc-fds",
    srcs: ["graphics/hwc_utgard_fds.cpp"],
    visibility: ["//external/drm_hwcomposer:__pkg__"],
}
