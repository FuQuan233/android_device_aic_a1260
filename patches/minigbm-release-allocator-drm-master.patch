diff --git a/cros_gralloc/cros_gralloc_driver.cc b/cros_gralloc/cros_gralloc_driver.cc
index 706dee9..e4d6979 100644
--- a/cros_gralloc/cros_gralloc_driver.cc
+++ b/cros_gralloc/cros_gralloc_driver.cc
@@ -110,8 +110,21 @@ static struct driver *init_try_node(int idx, char const *str)
 		return NULL;
 
 	drv = drv_create(fd, NULL);
-	if (!drv)
+	if (!drv) {
 		close(fd);
+		return NULL;
+	}
+
+	/* Primary-node fallback can acquire DRM master on display-only devices.
+	 * Allocation does not need it; leave modesetting ownership to HWC, as
+	 * minigbm's GBM device discovery already does for primary nodes.
+	 */
+	if (drmIsMaster(fd) && drmDropMaster(fd)) {
+		ALOGE("Failed to release allocation device DRM master: %s", strerror(errno));
+		drv_destroy(drv);
+		close(fd);
+		return NULL;
+	}
 
 	return drv;
 }
