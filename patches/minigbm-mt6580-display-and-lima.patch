+ info.legacy_locked = true;
+ *address = info.stock_mapping.get();
+ return 0;
+}
+
+int32_t cros_gralloc_driver::legacy_unlock(buffer_handle_t handle)
+{
+ std::lock_guard<std::mutex> lock(mutex_);
+ auto hnd = cros_gralloc_convert_handle(handle);
+ auto it = handles_.find(hnd);
+ if (!hnd || it == handles_.end() || !it->second.legacy_locked)
+  return -EINVAL;
+ auto &info = it->second;
+ if (info.legacy_sync_flags) {
+  struct dma_buf_sync sync = { .flags = info.legacy_sync_flags | DMA_BUF_SYNC_END };
+  if (ioctl(hnd->fds[1], DMA_BUF_IOCTL_SYNC, &sync)) return -errno;
+ }
+ info.legacy_locked = false;
+ info.legacy_sync_flags = 0;
+ return 0;
+}
+#endif
