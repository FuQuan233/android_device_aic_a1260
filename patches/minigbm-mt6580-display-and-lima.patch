 #define CROS_GRALLOC_HANDLE_H
 
 #include <cstdint>
+#include <cstddef>
 #include <cutils/native_handle.h>
 
 #define DRV_MAX_PLANES 4
 #define DRV_MAX_FDS (DRV_MAX_PLANES + 1)
 
+#ifdef MT6580_UTGARD_HANDLE
+/* Exact stock ARM32 wire ABI. No native pointers may be trusted after IPC.
+ * One image plane only: the array views overlap stock geometry/usage words.
+ * Never copy full array views; import only the validated num_planes entries.
+ */
+struct cros_gralloc_handle : public native_handle_t {
+ int32_t fds[2]; /* fd0: modern metadata; fd1: image DMA-BUF */
+ union {
+  uint32_t strides[4];
+  struct { uint32_t _stride; uint32_t offsets[4]; };
+  struct { uint32_t _geometry_pad[2]; uint32_t width, height; int32_t droid_format;
+           uint32_t pixel_stride, stock_allocation_height, id, tiling; };
+ };
+ union {
+  uint32_t sizes[4];
+  struct { uint32_t _size; uint32_t num_planes; int64_t usage; uint64_t stock_producer_usage; };
+ };
+ uint32_t stock_magic, stock_flags, stock_usage, stock_size;
+ uint32_t stock_width, stock_height, stock_format, stock_pixel_stride;
+ uint32_t stock_cpu_base, format, stock_lock_state, stock_write_usage;
+ int32_t stock_pid;
+ uint32_t magic;
+ uint64_t format_modifier, use_flags, reserved_region_size, total_size;
+} __attribute__((packed));
+static_assert(sizeof(cros_gralloc_handle) == 168, "Mali stock handle ABI");
+/* GCC/Clang warn offsetof on native_handle inheritance; the fixed wire layout
+ * is additionally checked by the standalone layout verification program. */
+#else
 struct cros_gralloc_handle : public native_handle_t {
 	/*
 	 * File descriptors must immediately follow the native_handle_t base and used file
@@ -42,6 +71,23 @@ struct cros_gralloc_handle : public native_handle_t {
 	uint64_t total_size; /* Total allocation size */
 } __attribute__((packed));
 
+#endif
+
 typedef const struct cros_gralloc_handle *cros_gralloc_handle_t;
+static inline uint32_t cros_gralloc_plane_fd_index(uint32_t plane) {
+#ifdef MT6580_UTGARD_HANDLE
+ return plane + 1;
+#else
+ return plane;
+#endif
+}
+static inline uint32_t cros_gralloc_metadata_fd_index(cros_gralloc_handle_t hnd) {
+#ifdef MT6580_UTGARD_HANDLE
+ (void)hnd;
+ return 0;
+#else
+ return hnd->num_planes;
+#endif
+}
 
 #endif
