+
+/* Applications import KMS-allocated linear buffers through Lima's render node.
+ * Allocation stays on the KMS device, which provides contiguous scanout memory.
+ */
+static void *lima_import_bo_map(struct bo *bo, struct vma *vma, uint32_t map_flags)
+{
+	struct drm_lima_gem_info info = { .handle = bo->handle.u32 };
+	int prot = 0;
+
+	if (map_flags & BO_MAP_READ)
+		prot |= PROT_READ;
+	if (map_flags & BO_MAP_WRITE)
+		prot |= PROT_WRITE;
+	if (drmIoctl(drv_get_fd(bo->drv), DRM_IOCTL_LIMA_GEM_INFO, &info))
+		return MAP_FAILED;
+	vma->length = bo->meta.total_size;
+	return mmap(NULL, vma->length, prot, MAP_SHARED, drv_get_fd(bo->drv), info.offset);
+}
+
+const struct backend backend_lima = {
+	.name = "lima",
+	.init = dumb_driver_init,
+	.bo_destroy = drv_gem_bo_destroy,
+	.bo_import = drv_prime_bo_import,
+	.bo_export = drv_prime_bo_export,
+	.bo_map = lima_import_bo_map,
+	.bo_unmap = drv_bo_munmap,
+	.resolve_format_and_use_flags = drv_resolve_format_and_use_flags_helper,
