// SPDX-License-Identifier: Apache-2.0
cc_binary {
    name: "android.hardware.bluetooth-service.mt6580",
    vendor: true,
    relative_install_path: "hw",
    compile_multilib: "32",
    srcs: ["service.cpp"],
    init_rc: ["bluetooth.rc"],
    vintf_fragments: ["bluetooth.xml"],
    shared_libs: [
        "android.hardware.bluetooth-V1-ndk",
        "libbase",
        "libbinder_ndk",
        "liblog",
    ],
    cflags: ["-Wall", "-Wextra", "-Werror"],
    cppflags: ["-fexceptions"],
}
